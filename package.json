{
  "name": "software-factory",
  "private": true,
  "scripts": {
    "dev": "pnpm --recursive --parallel --filter @factory/api --filter @factory/web dev",
    "dev:api": "pnpm --filter @factory/api dev",
    "dev:web": "pnpm --filter @factory/web dev",
    "build": "pnpm typecheck && pnpm --filter @factory/web build",
    "typecheck": "tsc -b --pretty false && pnpm --filter @factory/web check",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:dependencies": "ncu --workspaces --root --dep prod,dev,optional --target minor --errorLevel 2",
    "update:dependencies": "ncu --workspaces --root --dep prod,dev,optional --target minor --upgrade --install never",
    "test": "tsc -b --pretty false && vitest run",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "lefthook": "^1.13.6",
    "npm-check-updates": "^23.1.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
